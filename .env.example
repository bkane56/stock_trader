# AI service cadence (used by python -m app.pipeline.run_loop; not the browser autonomous loop)
PIPELINE_INTERVAL_MINUTES=15
APP_LOG_LEVEL=INFO
# Default cash when API has no persisted briefing snapshot (align with paper portfolio defaults)
MORNING_BRIEFING_DEFAULT_CASH=100000

# Frontend InstantDB
VITE_INSTANTDB_APP_ID=your_instantdb_app_id_here

# Public URL of the Python AI API (required for Vercel / production builds).
# Local dev: http://127.0.0.1:8010 — never use localhost in Vercel env; use your deployed API HTTPS URL.
# VITE_PYTHON_AI_BASE_URL=https://your-api.example.com
# Minutes between autonomous research/briefing refreshes (autonomous mode only; default 15)
# VITE_AUTONOMOUS_RESEARCH_INTERVAL_MINUTES=15

# Market data provider selection (alpaca | polygon | mock)
MARKET_DATA_PROVIDER=alpaca
MARKET_DATA_MODE=free_iex
MARKET_DATA_CACHE_MINUTES=15
ENABLE_MARKET_DATA_FALLBACK=true
# Frontend label sync (should match MARKET_DATA_PROVIDER)
VITE_MARKET_DATA_PROVIDER=alpaca

# Alpaca market data (paper-trading quotes only — not live brokerage execution)
ALPACA_API_KEY_ID=alpa********
ALPACA_API_SECRET_KEY=alps********
ALPACA_DATA_FEED=iex

# Polygon fallback / previous-close mode
POLYGON_API_KEY=poly********
POLYGON_DATA_MODE=previous_close
POLYGON_PLAN=free

# AI runtime selection
AI_PROVIDER=openai
AI_MODEL=gpt-5-nano
# Minimum confidence required for top_3_buys in research output (0.0-1.0).
RESEARCH_MIN_BUY_CONFIDENCE=0.60
# Optional: override the default agent system prompt text.
AI_SYSTEM_PROMPT=
# Optional: local skills catalog controls for advisor tool use.
AI_SKILLS_INDEX_PATH=.skills_index.json
AI_SKILLS_ROOT_PATH=.cursor/skills
AI_SKILLS_PROMPT_LIMIT=15

# External model and search provider keys
OPENAI_API_KEY=sk-********
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SERPER_API_KEY=your_serper_api_key_here
# Optional: Brave Search MCP for the research agent (used together with fetch + Playwright MCP)
# BRAVE_API_KEY=

# Pushover notifications
PUSHOVER_USER=your_pushover_user_here
PUSHOVER_TOKEN=your_pushover_token_here
PUSHOVER_URL=https://api.pushover.net/1/messages.json

# Deterministic recommendation pipeline
USE_DETERMINISTIC_PIPELINE=true
CANDIDATE_UNIVERSE_EXTRA=

# Risk rules
MAX_POSITION_WEIGHT_PCT=30
TRIM_POSITION_WEIGHT_PCT=25
TAKE_PROFIT_GAIN_PCT=12
STOP_LOSS_PCT=-7
MIN_CASH_RESERVE_PCT=5
MAX_TRADES_PER_DAY=5
MAX_BUY_RECOMMENDATIONS_PER_RUN=3

# Agent turn limits
RECOMMENDATION_MAX_TURNS=6
RESEARCH_MAX_TURNS=8

# AI budget policy
MAX_RESEARCH_RUNS_PER_DAY=6
MIN_MINUTES_BETWEEN_RESEARCH_RUNS=60
MAX_SYMBOLS_PER_RESEARCH_RUN=12
MAX_LLM_CALLS_PER_RUN=2
USE_CACHED_RESEARCH_IF_FRESH=true
CANDIDATE_SCORE_CACHE_TTL_SEC=1800
RESEARCH_SUMMARY_CACHE_TTL_SEC=5400
RECOMMENDATION_CACHE_TTL_SEC=1800
